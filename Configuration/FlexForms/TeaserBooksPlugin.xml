<?xml version="1.0"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Optionen</sheetTitle>
                <type>array</type>
                <el>
                    <settings.templateLayout>
                        <label>LLL:EXT:books/Resources/Private/Language/locallang_be.xlf:flexforms_template.templateLayout</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <itemsProcFunc>Extcode\Cart\Hooks\ItemsProcFunc->user_templateLayout</itemsProcFunc>
                            <extKey>books</extKey>
                            <pluginName>TeaserBooks</pluginName>
                            <renderType>selectSingle</renderType>
                        </config>
                    </settings.templateLayout>
                    <settings.limit>
                        <exclude>1</exclude>
                        <label>LLL:EXT:books/Resources/Private/Language/locallang_be.xlf:tx_books.plugin.books.action.book.list.limit</label>
                        <config>
                            <type>input</type>
                            <size>3</size>
                            <max>3</max>
                            <eval>num</eval>
                            <checkbox>1</checkbox>
                            <range>
                                <lower>0</lower>
                                <upper>100</upper>
                            </range>
                            <default>0</default>
                        </config>
                    </settings.limit>
                    <settings.showPageUid>
                        <exclude>1</exclude>
                        <label>LLL:EXT:books/Resources/Private/Language/locallang_be.xlf:tx_books.plugin.books.action.book.list.select.single_pid</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <show_thumbs>1</show_thumbs>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.showPageUid>
                    <settings.bookUids>
                        <exclude>1</exclude>
                        <label>LLL:EXT:books/Resources/Private/Language/locallang_be.xlf:tx_books.plugin.books.action.book.teaser.select.books</label>
                        <config>
                            <type>select</type>
                            <renderType>selectMultipleSideBySide</renderType>
                            <foreign_table>tx_books_domain_model_book</foreign_table>
                            <size>3</size>
                            <minitems>1</minitems>
                            <maxitems>99</maxitems>
                        </config>
                    </settings.bookUids>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
